NODE_ENV=development
# Render supplies PORT. Production defaults to 0.0.0.0; local development uses 127.0.0.1.
HOST=127.0.0.1
PORT=3000
# Supply database credentials through your local environment or secret manager.
DATABASE_URL=
# Set this to the same local-only password used in DATABASE_URL before starting Compose.
POSTGRES_PASSWORD=
AUTH_MODE=oidc
# Auth0 tenant configuration. Use your Auth0 custom domain when one is approved.
# OIDC_ISSUER must end with /. OIDC_AUDIENCE is the Auth0 API Identifier.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Auth0 Universal Login authorization endpoint and application client ID.
OIDC_AUTHORIZATION_URL=
OIDC_CLIENT_ID=
# Comma-separated Auth0-enabled connections exposed by the frontend.
# Example: password,google
AUTH_METHODS=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
DOCS_ENABLED=true
FINANCIAL_MODE=disabled
# Optional Sentry DSN. Unexpected failures include only sanitized error details,
# request ID, operation ID, and stable error code.
ERROR_TRACKING_DSN=
# Cloudinary signed profile-media uploads. Required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Twilio Verify is disabled unless all four values are supplied through a local
# environment or secret manager. The API key secret must never reach a browser.
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
ABUSE_HASH_KEY=
# Persona is disabled unless all four values are supplied through a local
# environment or secret manager. Use comma-separated secrets during rotation.
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
PERSONA_API_VERSION=
PERSONA_WEBHOOK_SECRETS=
# Only the reviewed Swervpay sandbox boundary is available. Production remains
# fail closed until commercial, finance, legal and security approvals are recorded.
SWERVPAY_ENVIRONMENT=
SWERVPAY_BUSINESS_ID=
SWERVPAY_SECRET_KEY=
SWERVPAY_DATA_HASH_KEY=
SWERVPAY_DATA_ENCRYPTION_KEY=
